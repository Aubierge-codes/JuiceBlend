# =========================================================
# KcBlendz — environment configuration
# Copy to .env.local for development.
# =========================================================

# ---- Application ----
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_STORE=NG    # NG | MU | GL — overridden by user cookie

# ---- Database (PostgreSQL) ----
# Provided by docker-compose for local dev; Railway in production
DATABASE_URL="postgresql://kcblendz:kcblendz@localhost:5433/kcblendz?schema=public"
# Optional read replica for analytics queries
DATABASE_REPLICA_URL=""

# ---- Cache & queue (Redis) ----
REDIS_URL="redis://localhost:6379"

# ---- Auth ----
JWT_ACCESS_SECRET="change-me-to-a-256-bit-random-string"
JWT_REFRESH_SECRET="change-me-too-different-value"
JWT_ACCESS_TTL_SEC=86400         # 24h
JWT_REFRESH_TTL_SEC=2592000      # 30d
BCRYPT_ROUNDS=12
MFA_ISSUER=KcBlendz

# ---- Payments: Paystack (Nigeria store) ----
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=whsec_paystack_xxxxxxxxxxxx

# ---- Payments: Stripe (Mauritius + Global stores) ----
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_stripe_xxxxxxxxxxxx

# ---- Notifications: Twilio (WhatsApp) ----
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ---- Notifications: Email (SMTP via Resend / SendGrid) ----
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="KcBlendz <orders@kcblendz.com>"
DAILY_REPORT_TO=owner@kcblendz.com

# ---- Image hosting ----
CLOUDINARY_CLOUD_NAME=kcblendz
CLOUDINARY_API_KEY=xxxxxxxxxxxxxxx
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# ---- Currency exchange (Global store fallback pricing) ----
FX_API_KEY=xxxxxxxxxxxxxxxxxxxx
FX_CACHE_TTL_SEC=3600

# ---- Observability ----
LOG_LEVEL=info
