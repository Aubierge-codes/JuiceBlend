{
  "name": "kcblendz",
  "version": "0.1.0",
  "private": true,
  "description": "KcBlendz multi-storefront e-commerce platform — Nigeria, Mauritius, Global. Custom smoothie builder, Paystack & Stripe payments, WhatsApp/email notifications, automated daily sales reports.",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force && pnpm db:seed",
    "worker:cron": "tsx workers/daily-report.ts",
    "worker:notifications": "tsx workers/notification-worker.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@stripe/stripe-js": "^5.4.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.34.0",
    "clsx": "^2.1.1",
    "decimal.js": "^10.4.3",
    "framer-motion": "^11.15.0",
    "ioredis": "^5.4.2",
    "jose": "^5.9.6",
    "lucide-react": "^0.469.0",
    "next": "15.1.3",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.16",
    "otpauth": "^9.3.6",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0",
    "stripe": "^17.5.0",
    "tailwind-merge": "^2.5.5",
    "twilio": "^5.4.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.1.3",
    "next-pwa": "^5.6.0",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
